# Copia este archivo como .env.local y llena los valores de tu proyecto de Supabase
# (Supabase > Project Settings > API Keys).
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Solo en el servidor. Nunca la expongas en el navegador ni la subas a GitHub.
# Está en API Keys > "Secret keys" (botón para revelar/copiar), no en el panel "Connect".
SUPABASE_SECRET_KEY=sb_secret_...
# URL pública del sitio, se usa en los enlaces de reseña.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Llave Bre-B para aportes voluntarios.
NEXT_PUBLIC_BREB_KEY=@carguero# Cloudflare Turnstile (protege el registro y las reseñas). Sin la sitekey, la app funciona sin Turnstile.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAGGbSZgjfdeadwmm
# Solo en el servidor. Cloudflare > Turnstile > widget "carguero" > Secret key.
TURNSTILE_SECRET=
# Dominios que el servidor acepta. Local: localhost,127.0.0.1. En Vercel: carguero.vercel.app (sin localhost).
TURNSTILE_HOSTNAMES=localhost,127.0.0.1
